{
  "name": "book-monkey5-public-api",
  "description": "REST Server Backend for our Angular Book",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "author": {
    "name": "Angular Buch Team",
    "email": "team@angular-buch.com"
  },
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "start": "node src/start.ts",
    "start:dev": "NODE_ENV=development node --watch src/start.ts",
    "typecheck": "tsc",
    "test": "NODE_ENV=test node --test"
  },
  "scarfSettings": {
    "enabled": false
  },
  "dependencies": {
    "cors": "2.8.6",
    "express": "5.3.0",
    "morgan": "1.12.1",
    "swagger-ui-express": "5.0.1",
    "web-push": "3.6.7",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/morgan": "1.9.10",
    "@types/node": "24.19.2",
    "@types/swagger-ui-express": "4.1.8",
    "@types/web-push": "3.6.4",
    "typescript": "7.0.2"
  },
  "overrides": {
    "swagger-ui-dist": "5.33.1"
  }
}
